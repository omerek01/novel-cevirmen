# Bu dosya ŞABLONDUR — gerçek anahtarlar `.env` içine yazılır ve git'e GİRMEZ.
# Kurulum: bu dosyayı `.env` olarak kopyala, değerleri doldur.
# Sunucuda: chmod 600 .env

# --- Çeviri anahtarları ---------------------------------------------------

# Zincirin BİRİNCİ anahtarı. Yalnız YENİ çeviri için gerekir; önbellek
# isabetinde hiç kullanılmaz.
GEMINI_API_KEY=

# İkinci, üçüncü... anahtar. Birincinin kotası dolunca (429) aynı MODELDE
# devralır. Ad esnek: GEMINI2_API_KEY / GEMINI_API_KEY_2 / GEMINI3_API_KEY...
# UYARI: Gemini kotası PROJE başınadır, ANAHTAR başına değil. Aynı Google Cloud
# projesinden alınmış ikinci anahtar hiçbir şey kazandırmaz — AYRI projelerden al.
GEMINI2_API_KEY=

# NVIDIA (build.nvidia.com) — zincirin SON halkası z-ai/glm-5.3. ÜCRETSİZ, kart
# bağlanmaz; sınırda 429 döner. Google dışı yedek: Gemini halkalarının hepsi
# düştüğünde çeviri durmaz. Boşsa halka sessizce atlanır.
NVIDIA_API_KEY=

# Vertex AI — AYNI gemini-3.6-flash, Google Cloud faturasıyla (deneme kredisi
# buraya harcanabilir, AI Studio anahtarlarına harcanamaz). ÜCRETLİDİR ve yalnız
# okuyucudan "3.6 Flash (Vertex, kredi)" seçilince kullanılır. Sır DEĞİL: kimlik
# sunucu VM'inin servis hesabıdır (cloud-platform kapsamı + roles/aiplatform.user).
# Boşsa halka sessizce atlanır. VERTEX_KONUM boşsa "global".
VERTEX_PROJE=
VERTEX_KONUM=

# Claude halkaları (claude-haiku-4-5 / claude-sonnet-5). ÜCRETLİDİR ve yalnız
# okuyucudan açıkça seçilince kullanılır; ücretsiz zincir asla buraya inmez.
# ANTHROPIC_API_KEY adı da tanınır. Boşsa halka sessizce atlanır.
CLAUDE_API_KEY=

# --- Çekim (fetch) --------------------------------------------------------

# 0 -> düz HTTP yolunu KAPAT, doğrudan tarayıcıya düş. ACİL ÇIKIŞ.
# Varsayılan açık: bölüm sayfalarında Cloudflare koruması yok, düz HTTP 1 sn'de
# çekiyor (tarayıcı yolu aynı bölümde 68 sn sürüyordu). Site korumayı bölümlere
# yayarsa akış zaten kendiliğinden tarayıcıya düşer; bu anahtar yalnız o
# yedekleme de sorun çıkarırsa gerekir.
FETCH_HTTP_FIRST=

# Çekim trafiğini residential proxy üzerinden çıkarır.
# BULUT SUNUCUDA ŞART: Cloudflare veri merkezi IP'lerini reddediyor (ölçüm:
# VPS IP'sinde stealth Playwright challenge'ların ~%5'ini geçiyor). EV
# makinesinde BOŞ bırak — residential IP'desin, proxy gereksiz trafik yakar.
# Biçim: http://kullanici:parola@host:port
# Parolada @ ya da : varsa yüzde-kodla (@ -> %40, : -> %3A).
FETCH_PROXY=

# 1 -> roman çekerken resim/font/medya indirilmez (proxy trafiğini ~10 kat
# düşürür: bölüm başına ~2 MB yerine ~300 KB). Sunucuda 1 yap, ama ÖNCE proxy'yi
# tek başına doğrula — ikisi aynı anda açılırsa çekim bozulduğunda suçlu belli
# olmaz. script/stylesheet hiçbir zaman engellenmez (CF challenge JS ile çözülür).
# Manga yolu etkilenmez.
FETCH_BLOCK_ASSETS=

# Sert Cloudflare için kullanıcının elle başlattığı gerçek Chrome'a CDP ile
# bağlan (ör. http://127.0.0.1:9222). Chrome kapalıysa paket Chromium'a düşülür,
# yani ayarlı olsa da telefon/normal kullanım bozulmaz. Sunucuda BOŞ bırak.
FETCH_CDP_URL=

# 0 -> görünür pencere (Cloudflare'i bir kez elle çözmek için). Varsayılan 1.
FETCH_HEADLESS=

# Clearance tazelemesinin ziyaret edeceği hafif sayfa. Boşsa novelbin ana sayfası.
FETCH_CLEARANCE_URL=

# --- Test / bakım ---------------------------------------------------------

# Veritabanını başka bir dosyaya yönlendirir (test/CI). Boşsa cache/chapters.db.
NOVEL_DB_PATH=
